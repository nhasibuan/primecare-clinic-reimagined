# systemd unit template for the PrimeCare server (production mode).
# Install with:
#   sudo cp deploy/primecare.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now primecare
#
# NODE_ENV=production makes startup fail-fast on missing
# OAUTH_SERVER_URL / OWNER_OPEN_ID / BUILT_IN_FORGE_API_URL.

[Unit]
Description=PrimeCare Clinic server (production)
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
# Runs as an unprivileged user: a repository write (a compromised dependency,
# or a bad deploy) must not yield root, and this user cannot read the secrets
# file below.
User=primecare
Group=primecare
WorkingDirectory=/g/primecare-clinic-reimagined
# Secrets live OUTSIDE the deploy working tree. systemd reads this file as root
# and injects the variables; the service user never reads it.
EnvironmentFile=/root/secrets/primecare.env
Environment=NODE_ENV=production
Environment=PORT=3000
# Node is copied to a world-accessible path because the toolchain under /root
# (mode 700) is not reachable by the unprivileged service user.
ExecStart=/opt/primecare/node dist/index.js
Restart=on-failure
RestartSec=5
# Hardening.
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target