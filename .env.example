# PrimeCare Clinic — Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.

# ── Analytics (optional — leave empty to disable) ──
VITE_ANALYTICS_ENDPOINT=""
VITE_ANALYTICS_WEBSITE_ID=""

# ── Database ──
DATABASE_URL="mysql://user:password@localhost:3306/primecare"

# ── Application identity ──
VITE_APP_ID="primecare-local"

# ── Session signing ──
# MUST be a unique, random string ≥ 32 characters. Replace before any deployment.
JWT_SECRET="REPLACE_ME_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARS"

# ── Owner identity ──
# Set to your OAuth openId to bootstrap the first admin account.
OWNER_OPEN_ID=""

# ── OAuth ──
# Leave empty for local dev without login.
OAUTH_SERVER_URL=""

# ── Forge/Manus storage (optional for local dev) ──
BUILT_IN_FORGE_API_URL=""
BUILT_IN_FORGE_API_KEY=""

# ── Cloudflare Turnstile CAPTCHA ──
# Leave empty to use the test key in development.
TURNSTILE_SECRET_KEY=""
VITE_TURNSTILE_SITE_KEY=""

# ── Development-only flags ──
# Set to "true" ONLY in local dev to allow the always-pass Turnstile test key.
# WARNING: NEVER enable in staging or production.
TURNSTILE_ALLOW_TEST_KEY="false"
