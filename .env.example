# PrimeCare Clinic — Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.

# ── Analytics (optional — leave empty to disable) ──
VITE_ANALYTICS_ENDPOINT=""
VITE_ANALYTICS_WEBSITE_ID=""

# ── Database ──
DATABASE_URL="mysql://user:password@localhost:3306/primecare"

# ── Application identity ──
VITE_APP_ID="primecare-local"

# ── Session signing ──
# MUST be a unique, random string ≥ 32 characters. Replace before any deployment.
JWT_SECRET="REPLACE_ME_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARS"

# ── Owner identity ──
# Set to your OAuth openId to bootstrap the first admin account.
OWNER_OPEN_ID=""

# ── OAuth ──
# Leave empty for the self-hosted admin login below (recommended for
# single-owner deployments). Only needed when authenticating via Manus OAuth.
OAUTH_SERVER_URL=""

# ── Self-hosted admin login (default auth path) ──
# When both are set, production boots with a single-admin username/password
# login at /login (scrypt-verified, rate-limited, audit-logged) and the OAuth
# requirements are waived. Generate the hash with:
#   node scripts/hashPassword.mjs 'your-password'
ADMIN_USERNAME=""
ADMIN_PASSWORD_HASH=""

# ── Client auth mode ──
# "local" (default): the login button routes to the self-hosted /login page.
# "oauth": the login button redirects to the Manus portal at VITE_OAUTH_PORTAL_URL.
VITE_AUTH_MODE="local"
VITE_OAUTH_PORTAL_URL=""

# ── Forge/Manus storage (optional for local dev) ──
BUILT_IN_FORGE_API_URL=""
BUILT_IN_FORGE_API_KEY=""

# ── Cloudflare Turnstile CAPTCHA ──
# Leave empty to use the test key in development.
TURNSTILE_SECRET_KEY=""
VITE_TURNSTILE_SITE_KEY=""

# ── Development-only flags ──
# Set to "true" ONLY in local dev to allow the always-pass Turnstile test key.
# WARNING: NEVER enable in staging or production.
TURNSTILE_ALLOW_TEST_KEY="false"

# ── PII Field Encryption (UU PDP No. 27/2022 compliance) ──
# AES-256-GCM key for encrypting sensitive patient fields (NIK, phone, address)
# at the application layer before database storage.
# STRONGLY RECOMMENDED in production. Must be ≥ 32 characters.
# Generate: openssl rand -base64 48
# Store in a secrets manager (Vault, AWS Secrets Manager) — never commit this value.
PII_ENCRYPTION_KEY=""

# ── Emergency plaintext PII override (production only) ──
# Set to "true" ONLY as a transitional measure when PII_ENCRYPTION_KEY cannot
# yet be provisioned. Startup will then warn (not fail) and patient data will
# be stored UNENCRYPTED. Remove as soon as the key is available.
ALLOW_PLAINTEXT_PII="false"

# ── Distributed Rate Limiting (optional) ──
# Redis connection URL for the shared rate limiter across instances.
# When set, appointment and upload limiters use a Redis sorted-set sliding
# window (shared quota, survives restarts); commands degrade fail-open with
# throttled warnings if Redis is unreachable. Leave empty for the default
# in-memory sliding window (per-instance state, resets on restart).
# Example: redis://localhost:6379
REDIS_URL=""

# ── Rate-limiter degradation alerts (production) ──
# When REDIS_URL is set and the Redis limiter degrades, the server emails the
# alert address from /usr/local/lib/primecare-alert.env (the same channel as
# the watchdog). Edge-triggered: one email per degradation episode plus a
# reminder every 30 minutes while failures continue, with a 5-minute
# process-wide cooldown so a boot-time outage sends one email, not one per
# limiter. Set to "true" to disable entirely.
RATE_LIMITER_ALERTS_DISABLED="false"
